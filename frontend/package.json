{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"prepare": "husky",
		"lint": "eslint .",
		"lint:strict": "STRICT_LINT=1 eslint src",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"deps:check": "npm run deps:check:depcheck && npm run deps:check:exports",
		"deps:check:depcheck": "depcheck --specials=typescript,postcss --ignores=autoprefixer,postcss,prettier,depcheck,ts-prune",
		"deps:check:exports": "ts-prune -p tsconfig.app.json",
		"preview": "vite preview"
	},
	"dependencies": {
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-router": "^1.166.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.576.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"autoprefixer": "^10.4.27",
		"cross-env": "^10.1.0",
		"depcheck": "^1.4.7",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"jsdom": "^27.0.1",
		"lint-staged": "^16.4.0",
		"msw": "^2.12.14",
		"postcss": "^8.5.8",
		"prettier": "^3.8.1",
		"tailwindcss": "^3.4.17",
		"ts-prune": "^0.10.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.48.0",
		"vite": "^7.3.1",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"cross-env STRICT_LINT=1 eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": "prettier --write"
	}
}
