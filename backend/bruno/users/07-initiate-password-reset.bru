meta {
  name: Initiate Password Reset
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/reset-password/initiate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}"
  }
}

script:post-response {
  const data = res.getBody();

  if (data?.resetToken) {
    bru.setEnvVar("resetToken", data.resetToken, { persist: true });
  }

  if (data?.expiresAtUtc) {
    bru.setEnvVar("resetTokenExpiresAtUtc", data.expiresAtUtc, { persist: true });
  }
}
