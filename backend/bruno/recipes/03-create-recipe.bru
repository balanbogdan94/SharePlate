meta {
  name: Create Recipe
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/recipes
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  title: Spaghetti Carbonara
  notes: Classic Italian pasta dish
  ingredients[0].name: Spaghetti
  ingredients[0].quantity: 200
  ingredients[0].unit: Gram
  ingredients[1].name: Guanciale
  ingredients[1].quantity: 150
  ingredients[1].unit: Gram
  ingredients[2].name: Egg
  ingredients[2].quantity: 4
  ingredients[2].unit: Piece
}

script:post-response {
  const data = res.getBody();

  if (data?.id) {
    bru.setEnvVar("recipeId", data.id, { persist: true });
  }
}
