meta {
  name: Update Recipe
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/recipes/{{recipeId}}
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart-form {
  title: Spaghetti Carbonara (Updated)
  notes: Classic Italian pasta dish with guanciale
  removeImage: false
  ingredients[0].name: Spaghetti
  ingredients[0].quantity: 250
  ingredients[0].unit: Gram
  ingredients[1].name: Guanciale
  ingredients[1].quantity: 150
  ingredients[1].unit: Gram
  ingredients[2].name: Egg
  ingredients[2].quantity: 4
  ingredients[2].unit: Piece
}
